import /.at.lang.futures;
import /.at.lang.multifutures;

import ~.data;
import ~.gameRules;
def Operations := object: { import ~.operations; };

import /.at.collections.java.hashmap;
import /.at.support.timer exclude seconds, minutes, millisec;

enableFutures(false);

deftype Player;
// --- CONFIGURATION ---
def LOBBY := 0;
def PLAYING := 1;
def DELAY_START_SESSION := 5.seconds;
def CRASH_TIMEOUT := 30.seconds;
def MAX_PLAYERS := 4;
def MIN_PLAYERS := 2;

def VOTE_TIMEOUT := 2.seconds;

def log(text){ system.println("[AT] " + text); };

def UUID := jlobby.java.util.UUID;
def WeKittensApp := jlobby.weKittens.WeKittensApp;


def makeAmbientKittens() {
  def gui;

  // --- ETAT ---
  def myState := LOBBY;
  def currentSessionId := nil;
  def myUserId := UUID.randomUUID().toString();
  def isTimerRunning := false;

  def gameModel := nil;
  def opHistory := [];
  def lastOpUuid := "GENESIS";

  def playersById  := HashMap.new();
  def playerStates := HashMap.new();
  def playerIdsList := [];
  def sessionPlayerIds := [];
  def pendingDisconnects := HashMap.new();

  log("myUserId = " + myUserId);

  def broadcastMyState(newState) {
      playerIdsList.each: { |id|
          def player := playersById.get(id);
          player<-updatePlayerState(myUserId, newState);
      };
  };

  def getAvailablePlayers() {
      def candidates := [];
      playerIdsList.each: { |id|
          def state := playerStates.get(id);
          if: (state == nil) then: { state := LOBBY; }; // recover disconnection
          if: (state == LOBBY) then: {
              candidates := candidates + [ playersById.get(id) ];
          };
      };
      candidates;
  };

  def amITheLeader(opponentsRefs) {
      def iAmLeader := true;
      playerIdsList.each: { |id|
          def state := playerStates.get(id);
          if: (state == nil) then: { state := LOBBY; };
          if: (state == LOBBY) then: {
             if: ((id <=> myUserId) == -1) then: {
                iAmLeader := false;
             };
          };
      };
      iAmLeader;
  };

   def updateJavaHand(playerId) {
       gui.clearHand();
       def myHand := gameModel.getHand(playerId);
       if: (myHand != nil) then: {
           system.println("[GUI] Synch of " + myHand.length + " cards");
           myHand.each: { |atCard|
               gui.addCardToHand(atCard.type, atCard.variant);
           };
       };
   };

  def updateTurnDisplay() {
      def currentPlayerId := gameModel.getCurrentPlayer();
      def turns := gameModel.getTurnsLeft();
      def isMe := (currentPlayerId == myUserId);

      def msg := "";
      if: isMe then: {
           msg := "Your turn | " + turns + " turn(s) left";
      } else: {
           msg := "Not your turn !";
      };
      gui.setTurnStatus(msg, isMe);
  };

  def startSessionNow() {
      if: (myState == LOBBY) then: {
          def availablePlayers := getAvailablePlayers();
          def opponents := [];
          if: (availablePlayers.length > (MAX_PLAYERS - 1)) then: {
              opponents := [availablePlayers[1], availablePlayers[2], availablePlayers[3]];
          } else: {
              opponents := availablePlayers;
          };

          sessionPlayerIds := [myUserId];
          playerIdsList.each: { |id|
             def playerRef := playersById.get(id);
             if: (opponents.contains(playerRef)) then: {
                 sessionPlayerIds := sessionPlayerIds + [id];
             };
          };

          gameModel := makeGameRules(sessionPlayerIds);
          def config := gameModel.createInitialState();
          gameModel.initGame(config);

          myState := PLAYING;
          currentSessionId := UUID.randomUUID().toString();
          opHistory := [];
          lastOpUuid := "GENESIS";

          broadcastMyState(myState);
          updateTurnDisplay();
          updateJavaHand(myUserId);
          gui.initializeSession(sessionPlayerIds.length);

          log(">>> STARTING SESSION : " + currentSessionId);
          log(">>> Players : " + sessionPlayerIds.length);
          opponents.each: { |player|
              player<-inviteToSession(currentSessionId, myUserId, config, sessionPlayerIds);
          };
          localInterface.showMessage("Started session as Host.");
      };
  };

  def checkLobbyStatus() {
      if: (myState == LOBBY) then: {
          def availableCount := getAvailablePlayers().length;
          def totalCount := availableCount + 1;
          log("Check Lobby: " + totalCount + " available players.");
          if: (totalCount >= MAX_PLAYERS) then: {
               if: (amITheLeader(getAvailablePlayers())) then: {
                   log("Lobby full & I am Leader -> Direct Start !");
                   startSessionNow();
               } else: {
                   log("Lobby full but I am NOT Leader -> Waiting.");
               };
          } else: {
              if: (totalCount >= MIN_PLAYERS) then: {
                  if: (!isTimerRunning) then: {
                      log("Waiting for others (" + totalCount + " present)...");
                      isTimerRunning := true;
                      when: DELAY_START_SESSION elapsed: {
                          isTimerRunning := false;
                          if: (myState == LOBBY) then: {
                              def finalCount := getAvailablePlayers().length + 1;  // Don't forget to add ourself.
                              if: (finalCount >= MIN_PLAYERS) then: {
                                  if: (amITheLeader(getAvailablePlayers())) then: {
                                      log("Timeout & I am Leader. Starting session.");
                                      startSessionNow();
                                  } else: {
                                      log("Timeout. I am NOT Leader. Waiting.");
                                  };
                              } else: {
                                  log("Timeout elapsed but players left."); // case could occur
                              };
                          };
                      };
                  };
              };
          };
      };
  };

  def localInterface := object: {

      def leaveSpectatingMode() {
          log("GUI requested to LEAVE SPECTATING MODE -> Calling leaveSession().");
          leaveSession();
      };

      def leaveSession() {
          log("GUI requested to LEAVE SESSION.");
          if: (myState == PLAYING) then: {
              def op := Operations.makePlayerLeftOp(myUserId, currentSessionId);
              performTwoPhaseCommit(op);

              myState := LOBBY;
              currentSessionId := nil;
              gameModel := nil;
              opHistory := [];
              lastOpUuid := "GENESIS";
              sessionPlayerIds := [];
              gui.resetToLobby();
              broadcastMyState(LOBBY);
              checkLobbyStatus();
          };
      };

      def playerDrewCard() {
          def decision := false;
          if: (myState == PLAYING) then: {
               def op := Operations.makeDrawCardOp(myUserId, currentSessionId);
               if: (gameModel.validateMove(op)) then: {
                   log("Draw Validated locally. Committing...");
                   performTwoPhaseCommit(op);
                   decision := true;
               } else: {
                   log("Draw Refused (Not your turn?).")
               };
          } else: { log("Not in session!"); };
          decision;
      };

      def nopePlayed(jCard) {
           def decision := false;
           if: (myState == PLAYING) then: {
               def aCard := atCardFromJCard(jCard);
               def op := Operations.makeNopeOp(myUserId, currentSessionId, aCard);
               if: (gameModel.validateMove(op)) then: {
                   performTwoPhaseCommit(op);
                   decision := true;
               } else: {
                   log("Nope refused (Invalid state/Dead?).");
               };
           };
           decision;
      };

      def getTargetIdFromRelative(targetRel) {
             def targetId := nil;
             if: (targetRel != -1) then: {
                   def myIndex := 0;
                   def count := sessionPlayerIds.length;
                   def i := 0;
                   sessionPlayerIds.each: { |playerId|
                       if: (playerId == myUserId) then: { myIndex := i; };
                       i := i + 1;
                   };
                   def offset := targetRel;
                   if: (count == 2) then: { offset := 1; };
                   def targetIndex := (myIndex + offset) % count;
                   targetId := sessionPlayerIds[targetIndex + 1];
             };
             targetId;
      };

      def getRelativeIndex(targetId) {
           def myIndex := -1;
           def targetIndex := -1;
           def count := sessionPlayerIds.length;
           def i := 0;
           sessionPlayerIds.each: { |playerId|
               if: (playerId == myUserId) then: { myIndex := i; };
               if: (playerId == targetId) then: { targetIndex := i; };
               i := i + 1;
           };
           def relative := (targetIndex - myIndex + count) % count;
           if: (count == 2) then: { if: (relative == 1) then: { relative := 2; }; };
           relative;
      };

      def getOpponentHandSize(targetRel) {
           def size := 1;
           if: (myState == PLAYING) then: {
               def targetId := getTargetIdFromRelative(targetRel);
               if: (targetId != nil) then: {
                   def hand := gameModel.getHand(targetId);
                   if: (hand != nil) then: {
                       size := hand.length;
                       system.println("[INFO] Opponent hand size (" + targetId + ") : " + size);
                   };
               };
           };
           size;
      };

      def pairPlayed(jCard, targetRel, stealCardIdx) {
           def decision := false;
           if: (myState == PLAYING) then: {
               def aCard := atCardFromJCard(jCard);
               def targetId := getTargetIdFromRelative(targetRel);

               if: (targetId != nil) then: {
                   system.println("[PAIR] Playing pair on " + targetId + " index " + stealCardIdx);
                   def op := Operations.makePairOp(myUserId, currentSessionId, aCard, targetId, stealCardIdx);
                   if: (gameModel.validateMove(op)) then: {
                       performTwoPhaseCommit(op);
                       decision := true;
                   } else: {
                       log("Pair move refused (gameRules check failed).");
                   };
               };
           };
           decision;
      };

      def triplePlayed(jCard, targetRel, requestedType, requestedVar) {
            def decision := false;
            if: (myState == PLAYING) then: {
                def aCard := atCardFromJCard(jCard);
                def targetId := getTargetIdFromRelative(targetRel);
                if: (targetId != nil) then: {
                    system.println("[TRIPLE] Asking " + targetId + " for " + requestedType + " (" + requestedVar + ")");
                    def op := Operations.makeTripleOp(myUserId, currentSessionId, aCard, targetId, requestedType, requestedVar);
                    if: (gameModel.validateMove(op)) then: {
                        performTwoPhaseCommit(op);
                        decision := true;
                    } else: {
                        log("Triple move refused (gameRules check failed).");
                    };
                };
            };
            decision;
      };

      def special5ComboPlayed() {
           def decision := false;
           if: (myState == PLAYING) then: {
               def op := Operations.makeSpecial5Op(myUserId, currentSessionId);
               if: (gameModel.validateMove(op)) then: {
                   performTwoPhaseCommit(op);
                   decision := true;
               } else: {
                   log("Special 5 combo refused (Rules check failed).");
               };
           };
           decision;
      };

      def pickFromDiscard(cardType, cardVar) {
           def decision := false;
           if: (myState == PLAYING) then: {
               def targetCard := atCard.new(cardType, cardVar);
               def op := Operations.makeTakeDiscardOp(myUserId, currentSessionId, targetCard);
               if: (gameModel.validateMove(op)) then: {
                   performTwoPhaseCommit(op);
                   decision := true;
               } else: {
                   log("Pick from discard refused (Rules check failed).");
               };
           };
           decision;
      };

      def cardPlayed(jCard, targetInfo) {
              def decision := false;
              if: (myState == PLAYING) then: {
                   def aCard := atCardFromJCard(jCard);

                   if: (aCard.type == "defuse") then: {
                       system.println("[GUI] Defuse detected. Free GUI.");
                       decision := true;
                       when: 0.seconds elapsed: {
                           def maxDeckIdx := gameModel.getDeckSize();
                           def chosenIdx := gui.askInsertionIndex(maxDeckIdx);
                           def op := Operations.makeDefuseOp(myUserId, currentSessionId, aCard, chosenIdx);
                           if: (gameModel.validateMove(op)) then: {
                               performTwoPhaseCommit(op);
                           } else: {
                               log("Defuse invalid.");
                               updateJavaHand(myUserId);
                           };
                       };
                   }
                   else: {
                       def targetId := nil;
                       if: (aCard.type == "favor") then: {
                           if: (targetInfo != -1) then: {
                               def myIndex := 0;
                               def count := sessionPlayerIds.length;
                               def i := 0;
                               sessionPlayerIds.each: { |playerId|
                                   if: (playerId == myUserId) then: { myIndex := i; };
                                   i := i + 1;
                               };
                               def offset := targetInfo;
                               if: (count == 2) then: { offset := 1; };
                               def targetIndex := (myIndex + offset) % count;
                               targetId := sessionPlayerIds[targetIndex + 1];
                               system.println("[FAVOR] Target validated : " + targetId);
                           } else: {
                               system.println("[FAVOR] target error");
                           };
                       };

                       def seeds := [];
                       if: (aCard.type == "shuffle") then: {
                           1.to: 200 do: { |i| seeds := seeds + [jlobby.java.lang.Math.random()] };
                       };

                       def op := Operations.makePlayCardOp(myUserId, currentSessionId, aCard, targetId, seeds);
                       if: (gameModel.validateMove(op)) then: {
                           performTwoPhaseCommit(op);
                           decision := true;
                       } else: {
                           log("Move refused by local rules.");
                       };
                   };
              } else: {
                   log("Not in a session!");
              };
              decision;
      };
      def showMessage(msg) { log("| {GUI MSG} " + msg); };
  };

  def performTwoPhaseCommit(op) {
      def voters := [];
      sessionPlayerIds.each: { |id|
          if: !(id == myUserId) then: {
              def playerRef := playersById.get(id);
              if: !(playerRef == nil) then: { voters := voters + [playerRef]; };
          };
      };

      def activeParticipants := voters.length + 1; // add ourself in the count
      def quorum := (activeParticipants / 2).floor() + 1;
      system.println("[2PC] Voting Phase -> Need " + quorum + " votes (Active: " + activeParticipants + ")");

      def futures := voters.map: { |player|
          def [fut, resolver] := /.at.lang.futures.makeFuture();

          when: player<-prepare(op)@FutureMessage becomes: { |validation|
              try: { resolver.resolve(validation); } catch: { |e| };
          } catch: {|e|
                        try: { resolver.resolve(false); }
                            catch: { |e| }; };

          when: VOTE_TIMEOUT elapsed: { try: { resolver.resolve(false); } catch: { |e| }; };
          fut;
      };

      when: (group: futures) becomes: { |votes|
          def yesVotes := 1;
          votes.each: { |vote| if: (vote == true) then: { yesVotes := yesVotes + 1; }; };

          def localValid := false;
          if: (gameModel != nil) then: {
              localValid := gameModel.validateMove(op);
          } else: {
              if: ((op.type == "PLAYER_LEFT").and: { op.fromId == myUserId }) then: {
                  localValid := true;
                  system.println("[2PC] Override: Validation forcée du Leave (GameModel nil)");
              };
          };

          if: !localValid then: { yesVotes := 0; };
          system.println("[2PC] Result: " + yesVotes + " YES votes.");
          if: (yesVotes >= quorum) then: {
              system.println("[2PC] QUORUM REACHED ! COMMIT !");
              commitLocally(op);
              voters.each: { |player| player<-commit(op); }; //coordinator orders all other players to apply the op
          } else: {
              log("2PC ABORTED - No Quorum !");
          };
      };
  };

  def commitLocally(op) {
       opHistory := opHistory + [op];
       lastOpUuid := op.uuid;

       if: (gameModel == nil) then: {
           system.println("[WARN] comite on nil model -> player left the game");
       } else: {
           def res := gameModel.applyMove(op);

           // NOPE HANDLE
           if: (res == "ACTION_CANCELED") then: {
               localInterface.showMessage("NOPE! previous aciton canceled.");
               if: (op.fromId != myUserId) then: { gui.playCardOpponent("nope", op.card.variant); };
               updateJavaHand(myUserId);
               updateTurnDisplay();
           };

           if: (res == "ACTION_RESTORED") then: {
               localInterface.showMessage("YUP! Action restored");
               if: (op.fromId != myUserId) then: { gui.playCardOpponent("nope", op.card.variant); };
               updateJavaHand(myUserId);
               updateTurnDisplay();
           };

           if: (res == "NOPE_PREEMPTIVE") then: {
               localInterface.showMessage("PREEMPRITVE NOPE ACTIVATED! Game is stopped.");
               if: (op.fromId != myUserId) then: { gui.playCardOpponent("nope", op.card.variant); };
               updateJavaHand(myUserId);
           };

           if: (res == "BLOCKED_BY_NOPE") then: {
               localInterface.showMessage("ACTION BLOCKED by active nope");
               updateJavaHand(myUserId);
           };

           if: (res == "NOPE_USELESS") then: {
               localInterface.showMessage("Useledd Nope.");
               if: (op.fromId != myUserId) then: { gui.playCardOpponent("nope", op.card.variant); };
           };

           if: (op.type == "DRAW_CARD") then: {
               if: (op.fromId == myUserId) then: {

                   def status := res;
                   def cardObj := nil;

                   try: {
                       if: (res.length == 2) then: { status := res[1]; cardObj := res[2]; };
                   } catch: { |e| };

                   if: (status == "MUST_DEFUSE") then: {
                        def variant := "a";
                        if: (cardObj != nil) then: { variant := cardObj.variant; };
                        gui.showExplosionAlert(variant);
                        // FIX: all op update the hand
                        updateJavaHand(myUserId);
                        localInterface.showMessage("Need Defuse !");
                   };

                   if: ((status == "DIED").or: {status == "WINNER"}) then: {
                        def variant := "a";
                        if: (cardObj != nil) then: { variant := cardObj.variant; };
                        gui.showExplosionAlert(variant);
                        gui.showDeathMessage();
                        def top := gameModel.getDiscardTop();
                        if: (top != nil) then: { gui.playCardOpponent(top.type, top.variant); };
                   };

                   if: (status == "EMPTY") then: { localInterface.showMessage("La pioche est vide !"); };

                   if: (status == "DRAW_OK") then: {
                       // FIX: all op update the hand
                       updateJavaHand(myUserId);
                   };
               }
               else: {
                   def status := "UNKNOWN";
                   try: { if: (res.length == 2) then: { status := res[1]; }; } catch: { |e| };
                   if: ((status == "DIED").or: {status == "WINNER"}) then: {
                        markDeadOpponent(op.fromId);
                        def top := gameModel.getDiscardTop();
                        if: (top != nil) then: { gui.playCardOpponent(top.type, top.variant); };
                        if: (status == "WINNER") then: { gui.showWinMessage(); };
                   };
               };
           };

           if: (op.type == "PLAYER_LEFT") then: {
                localInterface.showMessage("Player " + op.fromId + " left the game.");
                markDeadOpponent(op.fromId);
                def top := gameModel.getDiscardTop();
                if: (top != nil) then: { gui.playCardOpponent(top.type, top.variant); };
                if: (res == "WINNER") then: { gui.showWinMessage(); };
                sessionPlayerIds := sessionPlayerIds.filter: { |id| id != op.fromId };
                system.println("[NET] Player removed from voters. New ovters " + sessionPlayerIds.length);
           };

           if: (op.type == "DEFUSE_KITTEN") then: {
               localInterface.showMessage("Bombe defused by " + op.fromId);
               if: (op.fromId != myUserId) then: { gui.playCardOpponent(op.card.type, op.card.variant); };
               if: (op.fromId == myUserId) then: { updateJavaHand(myUserId); };
           };

           if: (op.type == "PLAY_CARD") then: {
               if: (op.fromId == myUserId) then: {
                   def status := "OK";
                   def peekCards := [];
                   try: {
                       if: (res.length == 2) then: { status := res[1]; peekCards := res[2]; };
                   } catch: { |e| status := res; };

                   if: (status == "PEEK_FUTURE") then: {
                        system.println("[FUTURE] Display 3 top cards...");
                        def typesList := jlobby.java.util.ArrayList.new();
                        def varsList := jlobby.java.util.ArrayList.new();

                        peekCards.each: { |card|
                            typesList.add(card.type);
                            varsList.add(card.variant); };

                        gui.showSeeTheFuture(typesList, varsList);
                   };
                   // FIX: all op update the hand, to ensure that the played card disappear from the hand player
                   updateJavaHand(myUserId);
               }
               else: {
                   if: (op.card.type != "nope") then: { gui.playCardOpponent(op.card.type, op.card.variant); };
                   if: (op.card.type == "favor") then: {
                       def target := op.targetPlayer;
                       if: ((target == nil).or: { target == myUserId }) then: {
                           system.println("[FAVOR] I am the target of " + op.fromId);
                           def choiceString := gui.askCardToGive();
                           if: (choiceString != nil) then: {
                               def myHand := gameModel.getHand(myUserId);
                               def cardToGive := nil;
                               myHand.each: { |card|
                                   def name := card.type + " (" + card.variant + ")";
                                   if: ((cardToGive == nil).and: { name == choiceString }) then: { cardToGive := card; };
                               };
                               if: (cardToGive != nil) then: {
                                   def giveOp := Operations.makeGiveCardOp(myUserId, currentSessionId, op.fromId, cardToGive);
                                   when: 1.seconds elapsed: { performTwoPhaseCommit(giveOp); };
                               };
                           };
                       } else: {
                           system.println("[FAVOR] Target: " + target);
                       };
                   };
               };
           };

           if: (op.type == "GIVE_CARD") then: {
               localInterface.showMessage("Exchange : " + op.fromId + " gave a card to " + op.toId);
               if: ((op.fromId == myUserId).or: { op.toId == myUserId }) then: { updateJavaHand(myUserId); };
           };

           if: (op.type == "PLAY_PAIR") then: {
               if: (op.fromId != myUserId) then: { gui.playCardOpponent(op.card.type, op.card.variant); };
               if: (op.fromId == myUserId) then: {
                   updateJavaHand(myUserId);
                   localInterface.showMessage("PLaye Pair Combo on " + op.targetPlayer);
               }

               else: {
                   if: (op.targetPlayer == myUserId) then: {
                       system.println("[PAIR] stolen index " + op.stealIndex);
                       def myHand := gameModel.getHand(myUserId);
                       if: ((myHand != nil).and: { myHand.length > 0 }) then: {
                           def idx := (op.stealIndex - 1) % myHand.length;
                           def stolenCard := myHand[idx + 1];
                           localInterface.showMessage("Card stolen " + stolenCard.type);
                           def giveOp := Operations.makeGiveCardOp(myUserId, currentSessionId, op.fromId, stolenCard);
                           performTwoPhaseCommit(giveOp);
                       };
                   }
                   else: {
                       localInterface.showMessage(op.fromId + " steal a card from " + op.targetPlayer);
                   };
               };
           };

           if: (op.type == "PLAY_TRIPLE") then: {
               if: (op.fromId != myUserId) then: { gui.playCardOpponent(op.card.type, op.card.variant); };
               if: (op.fromId == myUserId) then: {
                   updateJavaHand(myUserId);
                   log("Request of " + op.reqType + " card sent to " + op.targetPlayer);
               }

               else: {
                   if: (op.targetPlayer == myUserId) then: {
                       system.println("[TRIPLE] requested card: " + op.reqType + " / " + op.reqVariant);
                       def myHand := gameModel.getHand(myUserId);
                       def foundCard := nil;
                       if: (myHand != nil) then: {
                           myHand.each: { |card|
                               if: (foundCard == nil) then: {
                                   def cardType := card.type + "";
                                   def cardVar := card.variant + "";
                                   def requestedType := op.reqType + "";
                                   def requestedVar := op.reqVariant + "";
                                   if: (cardType == requestedType) then: {
                                       if: (cardVar == requestedVar) then: { foundCard := card; };
                                   };
                               };
                           };
                       };
                       if: (foundCard != nil) then: {
                           log("Card found: " + foundCard.type);
                           def giveOp := Operations.makeGiveCardOp(myUserId, currentSessionId, op.fromId, foundCard);
                           performTwoPhaseCommit(giveOp);
                       }
                       else: {
                           log("Don't have this card: " + op.reqType);
                       };
                   } else: {
                       log(op.fromId + "request a sepcific card " + op.targetPlayer);
                   };
               };
           };

           if: (op.type == "PLAY_SPECIAL_5") then: {
               def status := "UNKNOWN";
               def pile := [];
               try: { if: (res.length == 2) then: { status := res[1]; pile := res[2]; }; }
                    catch: { |e| };

               if: ((status == "COMBO_5_OK").and: { pile.length >= 5 }) then: {
                   def len := pile.length;
                   (len - 4).to: len do: { |i|
                       def card := pile[i];
                       gui.playCardOpponent(card.type, card.variant);
                   };
               };

               if: (op.fromId == myUserId) then: {
                   updateJavaHand(myUserId);
                   if: (status == "COMBO_5_OK") then: {
                       def typesList := jlobby.java.util.ArrayList.new();
                       def varsList := jlobby.java.util.ArrayList.new();
                       pile.each: { |card| typesList.add(card.type); varsList.add(card.variant); };
                       gui.askPickFromDiscard(typesList, varsList);
                   };
               }

               else: {
                   localInterface.showMessage(op.fromId + " joue le COMBO 5 CARTES !");
               };
           };

           if: (op.type == "TAKE_DISCARD") then: {
               localInterface.showMessage(op.fromId + " chose a card from the discard pile");
               if: (op.fromId == myUserId) then: { updateJavaHand(myUserId); };
           };

           updateTurnDisplay();
       };
   };

   def markDeadOpponent(deadId) {
        def myIndex := -1;
        def oppIndex := -1;
        def count := sessionPlayerIds.length;
        def i := 0;
        sessionPlayerIds.each: { |playerId|
            if: (playerId == myUserId) then: { myIndex := i; };
            if: (playerId == deadId) then: { oppIndex := i; };
            i := i + 1;
        };
        def relative := (oppIndex - myIndex + count) % count;
        if: (count == 2) then: { if: (relative == 1) then: { relative := 2; }; };
        system.println("[GUI] Marking DEAD oppId: " + deadId + " at relative pos: " + relative);
        gui.markOpponentDead(relative);
   };


  def remoteInterface := object: {
    def getUserId() { myUserId; };
    def updatePlayerState(id, state) {
        log("UPDATE: Player " + id + " state -> " + state);
        playerStates.put(id, state);
        checkLobbyStatus();
    };

    def inviteToSession(sessionId, initiatorId, config, playerList) {
        if: (myState == LOBBY) then: {
            myState := PLAYING;
            currentSessionId := sessionId;
            sessionPlayerIds := playerList;
            gameModel := makeGameRules(sessionPlayerIds);
            gameModel.initGame(config);
            opHistory := [];
            lastOpUuid := "GENESIS";
            updateJavaHand(myUserId);
            gui.initializeSession(sessionPlayerIds.length);
            updateTurnDisplay();
            broadcastMyState(myState);
            log("INVITATION ACCEPTED from " + initiatorId);
            localInterface.showMessage("Joined session.");
        } else: {
            log("INVITATION DECLINED: Busy.");
        };
    };

    def fetchOpsSince(lastKnownUuid) {
        def missing := [];
        def recording := false;
        if: (lastKnownUuid == "GENESIS") then: { recording := true; };
        opHistory.each: { |op|
            if: recording then: { missing := missing + [op]; }
            else: { if: (op.uuid == lastKnownUuid) then: { recording := true; }; };
        };
        log("SYNC: Sending " + missing.length + " ops to requester.");
        missing;
    };

    def prepare(op) {
        if: (gameModel != nil) then: {
            gameModel.validateMove(op);
        } else: {
            system.println("[WARN] received prepare but the player left ! Vote FALSE.");
            false;
        };
    };

    def commit(op) {
        if: (gameModel != nil) then: {
            commitLocally(op);
        } else: {
            system.println("[WARN] received commit but the player left !. Ignored.");
        };
    };
  };

  def forceKickPlayer(crashedId) {
      log("TIMEOUT: Force kicking player " + crashedId);
      playersById.remove(crashedId);
      playerStates.remove(crashedId);
      if: (myState == PLAYING) then: {
          def op := Operations.makePlayerLeftOp(crashedId, currentSessionId);
          commitLocally(op);
          localInterface.showMessage("Player " + crashedId + " kicked (Timeout).");
      };
  };

  def pub := nil;
  def sub := nil;
  def goOnline() {
    pub := export: remoteInterface as: Player;
    sub := whenever: Player discovered: { |player|
         when: player<-getUserId()@FutureMessage becomes: { |id|
             if: (pendingDisconnects.containsKey(id)) then: {
                 log("Player " + id + " recovered before timeout!");
                 pendingDisconnects.remove(id);
             };

             if: (!(playersById.containsKey(id))) then: {
                 if: (id != myUserId) then: {
                     log("New player detected: " + id);
                     playersById.put(id, player);
                     if: (!playerStates.containsKey(id)) then: { playerStates.put(id, LOBBY); };
                     playerIdsList := playerIdsList + [id];
                     player<-updatePlayerState(myUserId, myState);
                     checkLobbyStatus();

                     if: ((myState == PLAYING).and: { sessionPlayerIds.contains(id) }) then: {
                         log("Player rejoined session. Requesting Sync...");
                         when: player<-fetchOpsSince(lastOpUuid)@FutureMessage becomes: { |ops|
                             if: (ops.length > 0) then: {
                                 log("Catching up " + ops.length + " operations...");
                                 ops.each: { |missedOp|
                                     if: (lastOpUuid != missedOp.uuid) then: { commitLocally(missedOp); };
                                 };
                                 localInterface.showMessage("Sync complete (" + ops.length + " ops).");
                             };
                         };
                     };

                     whenever: player disconnected: {
                         log("WARNING: Player " + id + " connection lost. Starting timer...");
                         pendingDisconnects.put(id, true);
                         when: CRASH_TIMEOUT elapsed: {
                             if: (pendingDisconnects.containsKey(id)) then: {
                                 log("CRASH CONFIRMED: Player " + id + " is gone for good.");
                                 pendingDisconnects.remove(id);
                                 forceKickPlayer(id);
                             } else: {
                                 log("Timer elapsed but player " + id + " had reconnected.");
                             };
                         };
                     };
                 };
             };
         };
    };
  };
  def goOffline(){ pub.cancel(); sub.cancel(); };

  gui := WeKittensApp.new(localInterface);
  goOnline();
  system.println("WeKittens ready. GUI: " + gui);
};

network.online();
makeAmbientKittens();