import /.at.lang.futures;
import /.at.lang.multifutures;
import /.at.support.timer exclude seconds, minutes, millisec;
import /.at.unit.test;

deftype Player;
def UUID := jlobby.java.util.UUID;

def createPlayerModel(name) {
    def myGeneratedId := UUID.randomUUID().toString();
    def PlayerType := Player;

    actor: {
        def LOBBY := 0;
        def PLAYING := 1;

        def myName := name;
        def myUserId := myGeneratedId;
        def myState := LOBBY;
        def currentSessionId := nil;
        def sessionCounter := 0;

        def pub := nil;


        def knownPlayers := jlobby.java.util.HashMap.new();
        def opHistory := jlobby.java.util.ArrayList.new();
        def lastOpUuid := "GENESIS";


        def remoteInterface := object: {
            def getUserId() { myUserId; };

            def identify(peerId, peerRef) {
                knownPlayers.put(peerId, peerRef);
                peerRef<-updateState(myUserId, myState);
                if: (myState == PLAYING) then: {
                    peerRef<-requestSync(myUserId, lastOpUuid, remoteInterface);
                };
            };

            def updateState(id, state) { nil; };

            def inviteToSession(sessionId, initiatorId, config, pList) {
                if: (myState == LOBBY) then: {
                    myState := PLAYING;
                    currentSessionId := sessionId;
                    opHistory.clear();
                    lastOpUuid := "GENESIS";
                    broadcastMyState(PLAYING);
                };
            };

            def requestSync(requesterId, lastKnownUuid, replyTo) {
                def missingOps := [];
                def recording := false;
                if: (lastKnownUuid == "GENESIS") then: { recording := true; };

                def iter := opHistory.iterator();
                while: { iter.hasNext() } do: {
                    def op := iter.next();
                    if: recording then: { missingOps := missingOps + [op]; }
                    else: { if: (op.uuid == lastKnownUuid) then: { recording := true; }; };
                };

                if: (missingOps.length > 0) then: {
                    replyTo<-receiveSync(missingOps);
                };
            };


            def receiveSync(ops) {
                system.println("[" + myName + "] SYNC RECU: " + ops.length + " operations.");
                ops.each: { |op|
                    def exists := false;
                    def it := opHistory.iterator();
                    while: { it.hasNext() } do: {
                        def existing := it.next();
                        if: (existing.uuid == op.uuid) then: { exists := true; };
                    };

                    if: !exists then: {
                        opHistory.add(op);

                        lastOpUuid := op.uuid;
                    };
                };
            };

            def prepare(op) { true };

            def commit(op) {
                opHistory.add(op);
                lastOpUuid := op.uuid;
            };
        };

        def broadcastMyState(newState) {
            def refs := knownPlayers.values().iterator();
            while: { refs.hasNext() } do: {
                def p := refs.next();
                p<-updateState(myUserId, newState);
            };
        };


        def goOnline() {
            pub := export: remoteInterface as: PlayerType;
            whenever: PlayerType discovered: { |p|
                p<-identify(myUserId, remoteInterface);
            };
        };

        def goOffline() {
            if: (pub != nil) then: { pub.cancel(); pub := nil; };
        };

        def startSessionWith(opponents) {
            sessionCounter := sessionCounter + 1;
            def newSessionId := myUserId + " SESSION " + sessionCounter;

            opponents.each: { |opp|
                opp<-inviteToSession(newSessionId, myUserId, nil, [myUserId]);
            };

            // auto-invitation to lunch:
            remoteInterface.inviteToSession(newSessionId, myUserId, nil, []);
            newSessionId;
        };

        def inviteToSession(sessionId, initId, conf, playersList) {
            remoteInterface.inviteToSession(sessionId, initId, conf, playersList);
        };

        def simulateOp(payload) {
            def opId := myUserId + "OP" + (opHistory.size() + 1);
            def op := isolate: {
                def uuid := opId;
                def data := payload;
            };

            remoteInterface.commit(op);

            def refs := knownPlayers.values().iterator();
            while: { refs.hasNext() } do: {
                def p := refs.next();
                p<-commit(op);
            };
            opId;
        };

        def getOpHistory() {
            def res := [];
            def it := opHistory.iterator();
            while: { it.hasNext() } do: { res := res + [it.next()]; };
            res;
        };

        def getSessionId() { currentSessionId; };
        def getState() { myState; };
        def getKnownPlayersCount() { knownPlayers.size(); };
        def getMyId() { myUserId; };

        system.println("DEBUG: Actor " + myName + " fully initialized.");
    };
};

def DistributedTest := extend: /.at.unit.test.UnitTest.new("WeKittens Distributed Tests") with: {
    def actors := [];
    def tearDown() { actors.each: { |a| a<-goOffline() }; actors := []; };

    def testSessionCreation() {
        def [fut, res] := makeFuture();
        def p1 := createPlayerModel("Alice");
        def p2 := createPlayerModel("Bob");
        actors := [p1, p2];
        p1<-goOnline(); p2<-goOnline();

        when: 2.seconds elapsed: {
            when: p1<-startSessionWith([p2])@FutureMessage becomes: { |sessionId|
                when: 1.seconds elapsed: {
                    def f1 := p1<-getSessionId()@FutureMessage;
                    def f2 := p2<-getSessionId()@FutureMessage;
                    when: (group: [f1, f2]) becomes: { |results|
                        self.assertEquals(results[1], results[2], "Session IDs match");
                        res.resolve(true);
                    };
                };
            };
        };
        fut;
    };

    def testReconnection() {
        def [fut, res] := makeFuture();
        system.println("TEST SMR RECONNECTION");
        def alice := createPlayerModel("Alice_SMR");
        def bob := createPlayerModel("Bob_SMR");
        actors := [alice, bob];
        alice<-goOnline(); bob<-goOnline();

        when: 2.seconds elapsed: {
            alice<-startSessionWith([bob]);

            when: 1.seconds elapsed: {
                alice<-simulateOp("op 1");

                when: 1.seconds elapsed: {
                    system.println("Bob goes OFFLINE");
                    bob<-goOffline();

                    when: 1.seconds elapsed: {
                        alice<-simulateOp("op 2");

                        when: 1.seconds elapsed: {
                            system.println("Bob goes ONLINE");
                            bob<-goOnline();

                            when: 3.seconds elapsed: {
                                when: bob<-getOpHistory()@FutureMessage becomes: { |hist|
                                    system.println("Bob History size: " + hist.length);
                                    // Bob should have [op 1 (before deco), op 2 (sync)]
                                    self.assertEquals(2, hist.length, "Bob should have synced 2 ops");
                                    res.resolve(true);
                                };
                            };
                        };
                    };
                };
            };
        };
        fut;
    };

    def testDiscoveryCount() {
         system.println("TEST SMR DISCOVERY");
         def [fut, res] := makeFuture();
         def p1 := createPlayerModel("Host");
         def p2 := createPlayerModel("Guest1");
         actors := [p1, p2];
         p1<-goOnline(); p2<-goOnline();
         when: 2.seconds elapsed: {
             when: p1<-getKnownPlayersCount()@FutureMessage becomes: { |count|
                 self.assertTrue(count >= 1, "Discovery check failed. Found: " + count);
                 res.resolve(true);
             };
         };
         fut;
    };
};

DistributedTest.runTest();