def ArrayList := jlobby.java.util.ArrayList;
def Deck := jlobby.weKittens.Deck;
def CardType := jlobby.weKittens.Card.CardType;

object: {
  // --- IMPORTS ISOLES ---
  def Data := object: { import ~.data; };
  def Collections := object: { import /.at.collections.java.hashmap; };

  def makeGameRules(playerIds) {
    // --- ETAT DU JEU (State) ---
    def deck := [];
    def hands := Collections.HashMap.new();
    def activePlayers := playerIds;
    def currentPlayerIndex := 0;

    def turnsToTake := 1;
    def nextTurnCount := 1;

    def deadPlayers := [];
    def discardPile := [];

    // --- ETAT NOPE (Undo/Redo) ---
    def lastState := nil;
    def lastOp := nil;
    def nopeCount := 0;

    def localAtCard := Data.atCard;

    isolate: {
        // =================================================================
        // 1. INITIALISATION
        // =================================================================
        def createInitialState() {
            system.println("[RULES] Generation via Deck.java...");
            def jDeck := Deck.new(activePlayers.length);
            def initialHands := Collections.HashMap.new();

            activePlayers.each: { |pid|
                def hand := [];
                // 1 Defuse par joueur
                def jDefuse := jDeck.takeCard(CardType.defuse);
                if: (jDefuse != nil) then: { hand := hand + [Data.atCardFromJCard(jDefuse)]; };

                // + 7 cartes au hasard
                1.to: 7 do: { |i|
                    def jCard := jDeck.drawCard();
                    if: !(jCard == nil) then: { hand := hand + [Data.atCardFromJCard(jCard)]; };
                };
                initialHands.put(pid, hand);
            };

            jDeck.addExplodingKittens();

            // Conversion Deck Java -> AT
            def finalDeck := [];
            def pulling := true;
            while: { pulling } do: {
                def c := jDeck.drawCard();
                if: (c == nil) then: { pulling := false; } else: {
                    finalDeck := finalDeck + [Data.atCardFromJCard(c)];
                };
            };

            // Préparation données sérialisables
            def serializableHands := [];
            activePlayers.each: { |pid|
                def h := initialHands.get(pid);
                serializableHands := serializableHands + [[pid, h]];
            };

            isolate: {
                def syncedDeck := finalDeck;
                def syncedHandsData := serializableHands;
            };
        };

        def initGame(config) {
            deck := config.syncedDeck;
            hands := Collections.HashMap.new();
            config.syncedHandsData.each: { |entry|
                hands.put(entry[1], entry[2]);
            };

            activePlayers := playerIds;
            discardPile := [];
            currentPlayerIndex := 0;
            turnsToTake := 1;
            nextTurnCount := 1;
            deadPlayers := [];
            lastState := nil;
            lastOp := nil;
            nopeCount := 0;
            system.println("[RULES] GAME INIT COMPLETE.");
        };

        // =================================================================
        // 2. ACCESSEURS (Getters)
        // =================================================================
        def getCurrentPlayer() {
            if: (activePlayers.isEmpty()) then: { nil } else: { activePlayers[currentPlayerIndex + 1] };
        };
        def getTurnsLeft() { turnsToTake; };
        def getDeckSize() { deck.length; };
        def getHand(pid) { hands.get(pid); };
        def getDiscardTop() {
            if: (discardPile.isEmpty()) then: { nil } else: { discardPile[discardPile.length] };
        };
        def isNoped() { (nopeCount % 2) != 0; };

        // =================================================================
        // 3. LOGIQUE VALIDATION (Rules Checking)
        // =================================================================
        def validateMove(op) {
            def pid := op.fromId;
            def isValid := true;

            // Règle 0: Les morts ne jouent pas
            if: (deadPlayers.contains(pid)) then: { isValid := false; };

            if: isValid then: {
                // Règle 1: C'est mon tour ? (Sauf pour Nope)
                def isTurnBased := ["PLAY_CARD", "DRAW_CARD", "PLAY_PAIR", "PLAY_TRIPLE", "PLAY_SPECIAL_5"].contains(op.type);
                if: (isTurnBased) then: {
                    def isNopeCard := false;
                    if: (op.type == "PLAY_CARD") then: { if: (op.card.type == "nope") then: { isNopeCard := true; }; };

                    if: !isNopeCard then: {
                        if: (pid != getCurrentPlayer()) then: { isValid := false; };
                    };
                };
            };

            if: isValid then: {
                // Règle 2: A-t-on les cartes nécessaires ?
                if: (op.type == "PLAY_CARD") then: { isValid := checkHasCards(pid, op.card, 1); };
                if: (op.type == "PLAY_PAIR") then: { isValid := checkHasCards(pid, op.card, 2); };
                if: (op.type == "PLAY_TRIPLE") then: { isValid := checkHasCards(pid, op.card, 3); };
                if: (op.type == "PLAY_SPECIAL_5") then: { isValid := checkHas5Diff(pid); };

                if: (op.type == "TAKE_DISCARD") then: {
                    def found := false;
                    discardPile.each: { |c|
                        if: ((c.type == op.card.type).and: {c.variant == op.card.variant}) then: { found := true; };
                    };
                    isValid := found;
                };
            };

            isValid;
        };

        // Helpers Validation
        def checkHasCards(pid, template, qty) {
            def h := getHand(pid);
            def count := 0;
            h.each: { |c|
                if: ((c.type == template.type).and: {
                    (template.type == "cat").ifTrue: { c.variant == template.variant } ifFalse: { true }
                }) then: { count := count + 1; };
            };
            (count >= qty);
        };

        def checkHas5Diff(pid) {
            def h := getHand(pid);
            def uniqueKeys := [];
            h.each: { |c|
                def key := c.type;
                if: (c.type == "cat") then: { key := c.type + c.variant; };
                if: !(uniqueKeys.contains(key)) then: { uniqueKeys := uniqueKeys + [key]; };
            };
            (uniqueKeys.length >= 5);
        };

        // =================================================================
        // 4. MOTEUR D'EXECUTION (Logic Dispatcher)
        // =================================================================
        def applyMove(op) {
            def oldDeckSize := deck.length;
            def type := op.type;
            def pid := op.fromId;
            def finalResult := "OK";

            // --- CAS SPECIAL : NOPE (Undo/Redo System) ---
            if: (type == "PLAY_NOPE") then: {
                system.println("[NOPE] Joué par " + pid);
                consumeCards(pid, [op.card]);

                if: (lastState != nil) then: {
                    nopeCount := nopeCount + 1;
                    if: (isNoped()) then: {
                        cancelLastAction();
                        finalResult := "ACTION_CANCELLED";
                    } else: {
                        redoLastAction();
                        finalResult := "ACTION_RESTORED";
                    };
                } else: {
                    nopeCount := nopeCount + 1;
                    finalResult := "NOPE_PREEMPTIVE";
                };
            } else: {
                // --- EST-CE UNE ACTION BLOQUABLE ? ---
                def isBlockable := (["PLAY_CARD","PLAY_PAIR","PLAY_TRIPLE","PLAY_SPECIAL_5"].contains(type));

                if: (isBlockable) then: {
                    if: (isNoped().and: {lastState != nil}) then: {
                         nopeCount := 0; lastState := nil; lastOp := nil;
                    };

                    if: (isNoped()) then: {
                         system.println("[NOPE] Action bloquée préventivement.");
                         consumeCardsForOp(op);
                         nopeCount := 0;
                         finalResult := "BLOCKED_BY_NOPE";
                    } else: {
                        lastState := captureState();
                        lastOp := op;
                        nopeCount := 0;
                        consumeCardsForOp(op);
                        finalResult := executeOpLogic(op);
                    };
                } else: {
                    // --- ACTIONS NON BLOQUABLES / NETTOYAGE ---
                    if: (["DRAW_CARD", "DEFUSE_KITTEN", "TAKE_DISCARD"].contains(type)) then: {
                        lastState := nil; lastOp := nil; nopeCount := 0;
                        finalResult := executeOpLogic(op);
                    } else: {
                        // Autres (GIVE_CARD, PLAYER_LEFT)
                        finalResult := executeOpLogic(op);
                    };
                };
            };

            system.println("[DECK] Deck size: " + oldDeckSize + " -> " +  deck.length);
            finalResult;
        };

        // --- DISPATCHER LOGIQUE ---
        def executeOpLogic(op) {
            def t := op.type;
            def res := "OK";

            if: (t == "PLAY_CARD") then: { res := doPlaySingle(op); };
            if: (t == "PLAY_PAIR") then: { res := "PAIR_OK"; };
            if: (t == "PLAY_TRIPLE") then: { res := "TRIPLE_OK"; };
            if: (t == "PLAY_SPECIAL_5") then: { res := ["COMBO_5_OK", discardPile]; };
            if: (t == "DRAW_CARD") then: { res := doDrawCard(op); };
            if: (t == "DEFUSE_KITTEN") then: { res := doDefuse(op); };
            if: (t == "TAKE_DISCARD") then: { res := doTakeDiscard(op); };
            if: (t == "GIVE_CARD") then: { res := doGiveCard(op); };
            if: (t == "PLAYER_LEFT") then: { res := doPlayerLeft(op); };

            res;
        };

        // =================================================================
        // 5. IMPLEMENTATION DES EFFETS DE CARTES
        // =================================================================

        def doPlaySingle(op) {
            def cType := op.card.type;
            def res := "OK";

            if: (cType == "attack") then: {
                def extra := 2;
                if: (turnsToTake > 1) then: { extra := turnsToTake + 2; };
                nextTurnCount := extra;
                passTurnNoDraw();
                res := "ATTACK_OK";
            };
            if: (cType == "skip") then: {
                turnsToTake := turnsToTake - 1;
                if: (turnsToTake <= 0) then: { passTurnNoDraw(); };
                res := "SKIP_OK";
            };
            if: (cType == "shuffle") then: {
                performShuffle(op.shuffleData);
                res := "SHUFFLE_OK";
            };
            if: (cType == "future") then: {
                def peek := getTopCards(3);
                res := ["PEEK_FUTURE", peek];
            };

            res;
        };

        def doDrawCard(op) {
            def res := "DRAW_OK";
            if: (deck.isEmpty()) then: {
                res := "EMPTY";
            } else: {
                // --- FIX DECK DECREASE BUG ---
                def len := deck.length;
                def card := deck[len];

                // Reconstruction explicite avec boucle while pour être sûr
                def newDeck := [];
                def idx := 1;
                while: { idx < len } do: {
                    newDeck := newDeck + [deck[idx]];
                    idx := idx + 1;
                };
                deck := newDeck;

                // Sanity Check Debug
                if: (deck.length != (len - 1)) then: {
                    system.println("[ERR] Deck size BUG! Was " + len + " became " + deck.length);
                };

                if: (card.type == "exploding") then: {
                    def hand := getHand(op.fromId);
                    def hasDefuse := false;
                    hand.each: { |c| if: (c.type == "defuse") then: { hasDefuse := true; }; };

                    if: (hasDefuse) then: {
                        hands.put(op.fromId, hand + [card]);
                        res := ["MUST_DEFUSE", card];
                    } else: {
                        explosePlayer(op.fromId);
                        if: (activePlayers.length == 1) then: { res := ["WINNER", card]; }
                        else: { res := ["DIED", card]; };
                    };
                } else: {
                    hands.put(op.fromId, getHand(op.fromId) + [card]);
                    turnsToTake := turnsToTake - 1;
                    if: (turnsToTake <= 0) then: { advanceTurn(); };
                    res := ["DRAW_OK", card];
                };
            };
            res;
        };

        def doDefuse(op) {
            def pid := op.fromId;
            def hand := getHand(pid);

            def defuseCard := nil;
            def kittenCard := nil;

            // --- CORRECTION PARENTHESES ---
            hand.each: { |c|
                if: ((defuseCard == nil).and:{c.type == "defuse"}) then: { defuseCard := c; };
                if: ((kittenCard == nil).and:{c.type == "exploding"}) then: { kittenCard := c; };
            };

            if: (defuseCard != nil) then: {
                removeCardFromHand(pid, defuseCard);
                discardPile := discardPile + [defuseCard];
            };
            if: (kittenCard != nil) then: {
                removeCardFromHand(pid, kittenCard);
                insertCardIntoDeck(kittenCard, op.insertIndex);
            };

            turnsToTake := turnsToTake - 1;
            if: (turnsToTake <= 0) then: { advanceTurn(); };

            "DEFUSED";
        };

        def doTakeDiscard(op) {
            def target := op.card;
            def newDiscard := [];
            def found := false;
            discardPile.each: { |c|
                if: !found then: {
                    // --- CORRECTION PARENTHESES ---
                    if: ((c.type == target.type).and: {c.variant == target.variant}) then: { found := true; }
                    else: { newDiscard := newDiscard + [c]; };
                } else: { newDiscard := newDiscard + [c]; };
            };
            discardPile := newDiscard;

            def h := getHand(op.fromId);
            if: (h != nil) then: { hands.put(op.fromId, h + [target]); };

            "RECOVERED";
        };

        def doGiveCard(op) {
            removeCardFromHand(op.fromId, op.card);
            def targetHand := getHand(op.toId);
            if: (targetHand != nil) then: {
                hands.put(op.toId, targetHand + [op.card]);
            };
            "GIVEN";
        };

        def doPlayerLeft(op) {
            explosePlayer(op.fromId);
            if: (activePlayers.length == 1) then: { "WINNER" } else: { "DIED" };
        };

        // =================================================================
        // 6. UTILITAIRES DE GESTION DE CARTES
        // =================================================================

        def consumeCardsForOp(op) {
            def t := op.type;
            def pid := op.fromId;
            if: (t == "PLAY_CARD") then: { consumeCards(pid, [op.card]); };
            if: (t == "PLAY_PAIR") then: { consumeCards(pid, [op.card, op.card]); };
            if: (t == "PLAY_TRIPLE") then: { consumeCards(pid, [op.card, op.card, op.card]); };
            if: (t == "PLAY_SPECIAL_5") then: {
                def hand := getHand(pid);
                def uniqueKeys := [];
                def toRemove := [];
                hand.each: { |c|
                    def key := c.type + (c.type == "cat").ifTrue:{c.variant}ifFalse:{""};
                    if: (uniqueKeys.length < 5) then: {
                        if: !(uniqueKeys.contains(key)) then: {
                            uniqueKeys := uniqueKeys + [key];
                            toRemove := toRemove + [c];
                        };
                    };
                };
                consumeCards(pid, toRemove);
            };
        };

        def consumeCards(pid, cards) {
            cards.each: { |c|
                removeCardFromHand(pid, c);
                discardPile := discardPile + [c];
            };
        };

        def removeCardFromHand(pid, cardTemplate) {
            def hand := getHand(pid);
            def newHand := [];
            def removed := false;
            if: (hand != nil) then: {
                hand.each: { |card|
                    def keep := true;
                    if: !removed then: {
                        // --- CORRECTION PARENTHESES ---
                        if: ((card.type == cardTemplate.type).and: {card.variant == cardTemplate.variant}) then: {
                            removed := true;
                            keep := false;
                        };
                    };
                    if: keep then: { newHand := newHand + [card]; };
                };
                hands.put(pid, newHand);
            };
        };

        def insertCardIntoDeck(card, depth) {
            def currentSize := deck.length;
            def targetIndex := (currentSize + 1) - depth;
            if: (targetIndex < 1) then: { targetIndex := 1; };
            if: (targetIndex > (currentSize + 1)) then: { targetIndex := currentSize + 1; };

            def newDeck := [];
            def i := 1;
            while: { i < targetIndex } do: { newDeck := newDeck + [deck[i]]; i := i + 1; };
            newDeck := newDeck + [card];
            while: { i <= currentSize } do: { newDeck := newDeck + [deck[i]]; i := i + 1; };
            deck := newDeck;
        };

        def performShuffle(seeds) {
            def len := deck.length;
            if: ((len > 1).and: { seeds.length > 0 }) then: {
                def i := 1;
                while: { i < (seeds.length - 1) } do: {
                    def randA := seeds[i];
                    def randB := seeds[i+1];
                    def idxA := (randA * len).round() + 1;
                    def idxB := (randB * len).round() + 1;
                    if: (idxA > len) then: { idxA := len; }; if: (idxA < 1) then: { idxA := 1; };
                    if: (idxB > len) then: { idxB := len; }; if: (idxB < 1) then: { idxB := 1; };
                    def temp := deck[idxA]; deck[idxA] := deck[idxB]; deck[idxB] := temp;
                    i := i + 2;
                };
            };
        };

        def getTopCards(count) {
            def peekCards := [];
            def i := deck.length;
            def limit := 1;
            if: (deck.length < count) then: { count := deck.length; };
            if: (count > 0) then: { limit := deck.length - count + 1; };
            while: { i >= limit } do: {
                peekCards := peekCards + [deck[i]];
                i := i - 1;
            };
            peekCards;
        };

        // =================================================================
        // 7. GESTION D'ETAT (CAPTURE & RESTORE)
        // =================================================================
        def captureState() {
             def deckClone := [];
             deck.each: { |c| deckClone := deckClone + [c]; };
             isolate: {
                 def idx := currentPlayerIndex;
                 def turns := turnsToTake;
                 def next := nextTurnCount;
                 def savedDeck := deckClone;
             };
        };

        def cancelLastAction() {
            if: (lastState != nil) then: {
                currentPlayerIndex := lastState.idx;
                turnsToTake := lastState.turns;
                nextTurnCount := lastState.next;
                deck := lastState.savedDeck;
            };
            if: (lastOp != nil) then: {
                restoreCardsToPlayer(lastOp);
            };
        };

        def redoLastAction() {
            if: (lastOp != nil) then: {
                consumeCardsForOp(lastOp);
            };
            executeOpLogic(lastOp);
        };

        def restoreCardsToPlayer(op) {
            def pid := op.fromId;
            def count := 0;
            def t := op.type;
            if: (t == "PLAY_CARD") then: { count := 1; };
            if: (t == "PLAY_PAIR") then: { count := 2; };
            if: (t == "PLAY_TRIPLE") then: { count := 3; };
            if: (t == "PLAY_SPECIAL_5") then: { count := 5; };

            def cardsToReturn := [];
            1.to: count do: { |k|
                def c := discardPile[discardPile.length];
                if: (c != nil) then: {
                    cardsToReturn := cardsToReturn + [c];
                    def newD := [];
                    1.to: (discardPile.length - 1) do: { |x| newD := newD + [discardPile[x]]; };
                    discardPile := newD;
                };
            };
            hands.put(pid, getHand(pid) + cardsToReturn);
        };

        // =================================================================
        // 8. GESTION DES JOUEURS
        // =================================================================
        def passTurnNoDraw() {
            system.println("[PASS] Turn Pass (skip)");
            advanceTurn();
        };

        def advanceTurn() {
            currentPlayerIndex := (currentPlayerIndex + 1) % activePlayers.length;
            turnsToTake := nextTurnCount;
            nextTurnCount := 1;
            system.println("[TURN] Player " + getCurrentPlayer() + " (actions: " + turnsToTake + ")");
        };

        def explosePlayer(pid) {
            def idxToRemove := -1;
            def i := 0;
            activePlayers.each: { |p| if: (p == pid) then: { idxToRemove := i; }; i := i + 1; };

            if: (idxToRemove > -1) then: {
                def hand := hands.get(pid);
                if: (hand != nil) then: {
                    discardPile := discardPile + hand;
                    hands.remove(pid);
                };

                def newActive := [];
                activePlayers.each: { |p| if: (p != pid) then: { newActive := newActive + [p]; }; };
                activePlayers := newActive;
                deadPlayers := deadPlayers + [pid];

                if: (idxToRemove < currentPlayerIndex) then: { currentPlayerIndex := currentPlayerIndex - 1; };
                if: (currentPlayerIndex >= activePlayers.length) then: { currentPlayerIndex := 0; };

                turnsToTake := 1;
                nextTurnCount := 1;
                system.println("[EXPLOSION] Player " + pid + " has EXPLODED!");
            };
        };
    };
  };
};