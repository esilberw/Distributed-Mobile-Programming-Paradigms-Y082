def ArrayList := jlobby.java.util.ArrayList;
def Deck := jlobby.weKittens.Deck;
def CardType := jlobby.weKittens.Card.CardType;

object: {

  def Data := object: { import ~.data; };
  def Collections := object: { import /.at.collections.java.hashmap; };

  def makeGameRules(playerIds) {
    // State game:
    def deck := [];
    def hands := Collections.HashMap.new();
    def activePlayers := playerIds;
    def currentPlayerIndex := 0;

    def turnsToTake := 1;
    def nextTurnCount := 1;

    def deadPlayers := [];
    def discardPile := [];

    // For nope logic
    def lastState := nil;
    def lastOp := nil;
    def nopeCount := 0;

    def localAtCard := Data.atCard;

    isolate: {
        // Initialization of the initial common game state
        def createInitialState() {
            system.println("[RULES] Generation via Deck.java...");
            def jDeck := Deck.new(activePlayers.length);
            def initialHands := Collections.HashMap.new();

            activePlayers.each: { |pid|
                def hand := [];
                // 1 Defuse par joueur
                def jDefuse := jDeck.takeCard(CardType.defuse);
                if: (jDefuse != nil) then: { hand := hand + [Data.atCardFromJCard(jDefuse)]; };

                // + 7 radom card:
                1.to: 8 do: { |i|
                    def jCard := jDeck.drawCard();
                    if: !(jCard == nil) then: { hand := hand + [Data.atCardFromJCard(jCard)]; };
                };
                initialHands.put(pid, hand);
            };

            jDeck.addExplodingKittens();

            // Conversion Deck Java -> AT
            def finalDeck := [];
            def hasCards := true;
            while: { hasCards } do: {
                def card := jDeck.drawCard();
                if: (card == nil) then: { hasCards := false; } else: {
                    finalDeck := finalDeck + [Data.atCardFromJCard(card)];
                };
            };


            // makes this serializable
            def serializableHands := [];
            activePlayers.each: { |playerId|
                def hand := initialHands.get(playerId);
                serializableHands := serializableHands + [[playerId, hand]];
            };

            isolate: {
                def syncedDeck := finalDeck;
                def syncedHandsData := serializableHands;
            };
        };

        def initGame(config) {
            deck := config.syncedDeck;
            hands := Collections.HashMap.new(); // Keep a local track of all hands of eache player.
            config.syncedHandsData.each: { |entry|
                hands.put(entry[1], entry[2]); // [playerID , hand]
            };

            activePlayers := playerIds;
            discardPile := [];
            currentPlayerIndex := 0;
            turnsToTake := 1;
            nextTurnCount := 1;
            deadPlayers := [];
            lastState := nil;
            lastOp := nil;
            nopeCount := 0;
            system.println("[RULES] GAME INIT COMPLETE.");
        };


        // ACCESSORS
        def getCurrentPlayer() {
            if: (activePlayers.isEmpty()) then: { nil } else: { activePlayers[currentPlayerIndex + 1] };
        };

        def getTurnsLeft() { turnsToTake; };
        def getDeckSize() { deck.length; };
        def getHand(pid) { hands.get(pid); };

        def getDiscardTop() { // to maintain consistent GUI
            if: (discardPile.isEmpty()) then: { nil } else: { discardPile[discardPile.length] };
        };

        def isNoped() { (nopeCount % 2) != 0; }; // odd -> noped, even -> yup


        // Rules Checking:
        def validateMove(op) {
            def playerId := op.fromId;
            def isValid := true;

            // DeadPlayers cannot play:
            if: (deadPlayers.contains(playerId)) then: { isValid := false; };

            if: isValid then: {
                // Turn logic management except for nope card:
                def isTurnBased := ["PLAY_CARD", "DRAW_CARD", "PLAY_PAIR", "PLAY_TRIPLE", "PLAY_SPECIAL_5"].contains(op.type);
                if: (isTurnBased) then: {
                    def isNopeCard := false;
                    if: (op.type == "PLAY_CARD") then: {
                        if: (op.card.type == "nope") then: {
                            isNopeCard := true; };
                        };

                    if: !isNopeCard then: {
                        if: (playerId != getCurrentPlayer()) then: {
                            isValid := false;
                        };
                    };
                };
            };

            if: isValid then: {
                // Check if we have the played cards  (check consistency for me and others)
                if: (op.type == "PLAY_CARD") then: { isValid := checkHasCards(playerId, op.card, 1); };
                if: (op.type == "PLAY_PAIR") then: { isValid := checkHasCards(playerId, op.card, 2); };
                if: (op.type == "PLAY_TRIPLE") then: { isValid := checkHasCards(playerId, op.card, 3); };
                if: (op.type == "PLAY_SPECIAL_5") then: { isValid := checkHas5Diff(playerId); };

                if: (op.type == "TAKE_DISCARD") then: {
                    def found := false;
                    discardPile.each: { |card|
                        if: ((card.type == op.card.type).and: {card.variant == op.card.variant}) then: { found := true; };
                    };
                    isValid := found;
                };
            };

            isValid;
        };

        // Helpers Validation
        def checkHasCards(playerId, templateCard, quantity) {
            def hand := getHand(playerId);
            def count := 0;

            hand.each: { |card|
                if: (card.type == templateCard.type) then: {

                    // Check if it's not a "cat" Card +(OR) vairant in the case of a "cat" Card
                    if: ((templateCard.type != "cat").or: { card.variant == templateCard.variant }) then: {
                        count := count + 1;
                    };
                };
            };
            (count >= quantity);
        };

        def checkHas5Diff(playerId) {
            def hand := getHand(playerId);
            def uniqueKeys := [];
            hand.each: { |card|
                def key := card.type;
                if: (card.type == "cat") then: {
                    key := card.type + card.variant;
                    };

                if: !(uniqueKeys.contains(key)) then: {
                    uniqueKeys := uniqueKeys + [key];
                    };
            };
            (uniqueKeys.length >= 5);
        };


        // Handle nope + call the logic dispatcher:
        def applyMove(op) {
            def oldDeckSize := deck.length;
            def type := op.type;
            def playerId := op.fromId;
            def finalResult := "OK";

            // SPECIAL CASE : NOPE
            if: (type == "PLAY_NOPE") then: {
                system.println("[NOPE] played by " + playerId);
                consumeCards(playerId, [op.card]);

                if: (lastState != nil) then: {
                    nopeCount := nopeCount + 1;
                    if: (isNoped()) then: {
                        cancelLastAction();
                        finalResult := "ACTION_CANCELED";
                    } else: {
                        redoLastAction();
                        finalResult := "ACTION_RESTORED";
                    };
                } else: {
                    nopeCount := nopeCount + 1;
                    finalResult := "NOPE_PREEMPTIVE";
                };
            } else: {
                // CHeck if it is a blockable action:
                def isBlockable := (["PLAY_CARD","PLAY_PAIR","PLAY_TRIPLE","PLAY_SPECIAL_5"].contains(type));

                if: (isBlockable) then: {
                    if: (isNoped().and: {lastState != nil}) then: {
                         nopeCount := 0; lastState := nil; lastOp := nil; // we block
                    };

                    if: (isNoped()) then: {
                         system.println("[NOPE] Action blocked preventively");
                         consumeCardsForOp(op);
                         nopeCount := 0;
                         finalResult := "BLOCKED_BY_NOPE";
                    }
                    else: {
                        lastState := captureState();
                        lastOp := op;
                        nopeCount := 0;
                        consumeCardsForOp(op);
                        finalResult := executeOpLogic(op);
                    };
                }
                else: {
                    // UnBlockable acitons:
                    if: (["DRAW_CARD", "DEFUSE_KITTEN", "TAKE_DISCARD"].contains(type)) then: {
                        lastState := nil; lastOp := nil; nopeCount := 0;
                        finalResult := executeOpLogic(op);
                    } else: {
                        // last actions: (GIVE_CARD, PLAYER_LEFT)
                        finalResult := executeOpLogic(op);
                    };
                };
            };

            system.println("[DECK] Deck size: " + oldDeckSize + " -> " +  deck.length);
            finalResult;
        };

        // LOGIC DISPATCHER
        def executeOpLogic(op) {
            def opType := op.type;
            def res := "OK";

            if: (opType == "PLAY_CARD") then: { res := doPlaySingle(op); };
            if: (opType == "PLAY_PAIR") then: { res := "PAIR_OK"; };
            if: (opType == "PLAY_TRIPLE") then: { res := "TRIPLE_OK"; };
            if: (opType == "PLAY_SPECIAL_5") then: { res := ["COMBO_5_OK", discardPile]; };
            if: (opType == "DRAW_CARD") then: { res := doDrawCard(op); };
            if: (opType == "DEFUSE_KITTEN") then: { res := doDefuse(op); };
            if: (opType == "TAKE_DISCARD") then: { res := doTakeDiscard(op); };
            if: (opType == "GIVE_CARD") then: { res := doGiveCard(op); };
            if: (opType == "PLAYER_LEFT") then: { res := doPlayerLeft(op); };

            res;
        };


        // Implementation of cards effects :

        def doPlaySingle(op) {
            def cardType := op.card.type;
            def res := "OK";

            if: (cardType == "attack") then: {
                def extra := 2;
                if: (turnsToTake > 1) then: {
                    extra := turnsToTake + 2; // Logic of 2 -> 4 -> 6 if serveral attack cards in a row
                };

                nextTurnCount := extra;
                passTurnNoDraw();
                res := "ATTACK_OK";
            };

            if: (cardType == "skip") then: {
                turnsToTake := turnsToTake - 1;

                if: (turnsToTake <= 0) then: {
                    passTurnNoDraw();
                    };

                res := "SKIP_OK";
            };

            if: (cardType == "shuffle") then: {
                performShuffle(op.shuffleData);
                res := "SHUFFLE_OK";
            };

            if: (cardType == "future") then: {
                def peek := getTopCards(3);
                res := ["PEEK_FUTURE", peek];
            };

            res;
        };

        def doDrawCard(op) {
            def res := "DRAW_OK";
            if: (deck.isEmpty()) then: {
                res := "EMPTY"; // could have happened at the beginning of the project
            }

            else: {

                def len := deck.length;
                def card := deck[len];

                // explicit reconstruction of the deck after draw
                def newDeck := [];
                def idx := 1;
                while: { idx < len } do: {
                    newDeck := newDeck + [deck[idx]];
                    idx := idx + 1;
                };
                deck := newDeck;

                // Sanity check debug
                if: (deck.length != (len - 1)) then: {
                    system.println("[ERROR] Deck size BUG! Was " + len + " became " + deck.length);
                };

                if: (card.type == "exploding") then: {
                    def hand := getHand(op.fromId);
                    def hasDefuse := false;
                    hand.each: { |hCard| if: (hCard.type == "defuse") then: {
                        hasDefuse := true; };
                        };

                    if: (hasDefuse) then: {
                        hands.put(op.fromId, hand + [card]);
                        res := ["MUST_DEFUSE", card];
                    }

                    else: {
                        explosePlayer(op.fromId); // automatic epxlosion:
                        if: (activePlayers.length == 1) then: { res := ["WINNER", card]; }
                        else: { res := ["DIED", card]; };
                    };
                } else: {
                    hands.put(op.fromId, getHand(op.fromId) + [card]);
                    turnsToTake := turnsToTake - 1;
                    if: (turnsToTake <= 0) then: { advanceTurn(); };
                    res := ["DRAW_OK", card];
                };
            };
            res;
        };

        def doDefuse(op) {
            def playerId := op.fromId;
            def hand := getHand( playerId);

            def defuseCard := nil;
            def kittenCard := nil;

            hand.each: { |card|
                if: ((defuseCard == nil).and:{card.type == "defuse"}) then: { defuseCard := card; };
                if: ((kittenCard == nil).and:{card.type == "exploding"}) then: { kittenCard := card; };
            };

            if: (defuseCard != nil) then: {
                removeCardFromHand(playerId, defuseCard);
                discardPile := discardPile + [defuseCard];
            };
            if: (kittenCard != nil) then: {
                removeCardFromHand(playerId, kittenCard);
                insertCardIntoDeck(kittenCard, op.insertIndex);
            };

            turnsToTake := turnsToTake - 1;
            if: (turnsToTake <= 0) then: { advanceTurn(); };

            "DEFUSED";
        };

        def doTakeDiscard(op) {
            def targetCard := op.card;
            def newDiscard := [];
            def found := false;
            discardPile.each: { |discardCard|
                if: !found then: {
                    if: ((discardCard.type == targetCard.type).and: {discardCard.variant == targetCard.variant}) then: {
                        found := true;
                        }
                    else: {
                     newDiscard := newDiscard + [discardCard];
                     };
                } else: {
                newDiscard := newDiscard + [discardCard];
                };
            };
            discardPile := newDiscard;

            def hand := getHand(op.fromId);
            if: (hand != nil) then: {
                hands.put(op.fromId, hand + [targetCard]);
            };

            "RECOVERED";
        };

        def doGiveCard(op) {
            removeCardFromHand(op.fromId, op.card);
            def targetHand := getHand(op.toId);
            if: (targetHand != nil) then: {
                hands.put(op.toId, targetHand + [op.card]);
            };
            "GIVEN";
        };

        def doPlayerLeft(op) {
            explosePlayer(op.fromId);
            if: (activePlayers.length == 1) then: { "WINNER" } else: { "DIED" };
        };


        def consumeCardsForOp(op) {
            def opType := op.type;
            def playerId := op.fromId;
            // same cards
            if: (opType == "PLAY_CARD") then: { consumeCards(playerId, [op.card]); };
            if: (opType == "PLAY_PAIR") then: { consumeCards(playerId, [op.card, op.card]); };
            if: (opType == "PLAY_TRIPLE") then: { consumeCards(playerId, [op.card, op.card, op.card]); };

            // 5 different cards to manage:
            if: (opType == "PLAY_SPECIAL_5") then: {
                def hand := getHand(playerId);
                def uniqueKeys := [];
                def toRemove := [];

                hand.each: { |card|
                    def key := card.type;
                    if: (card.type == "cat") then: {
                        key := card.type + card.variant;
                        };


                    if: ((uniqueKeys.length < 5).and: { !(uniqueKeys.contains(key)) }) then: {
                        uniqueKeys := uniqueKeys + [key];
                        toRemove := toRemove + [card];
                        };
                };
                consumeCards(playerId, toRemove);
            };
        };

        def consumeCards(playerId, cards) {
            cards.each: { |card|
                removeCardFromHand(playerId, card);
                discardPile := discardPile + [card];
            };
        };

        def removeCardFromHand(playerId, cardTemplate) {
            def hand := getHand(playerId);
            def newHand := [];
            def foundAndRemoved := false;
            if: (hand != nil) then: {
                hand.each: { |card|
                    def keep := true;
                    if: !foundAndRemoved then: {
                        if: ((card.type == cardTemplate.type).and: {card.variant == cardTemplate.variant}) then: {
                            foundAndRemoved := true;
                            keep := false;
                        };
                    };
                    if: keep then: { newHand := newHand + [card]; };
                };
                hands.put(playerId, newHand);
            };
        };

        def insertCardIntoDeck(card, depth) {
            def currentSize := deck.length;
            def targetIndex := (currentSize + 1) - depth;
            if: (targetIndex < 1) then: { targetIndex := 1; };
            if: (targetIndex > (currentSize + 1)) then: { targetIndex := currentSize + 1; };

            // Deck reconstruction:
            def newDeck := [];
            def i := 1;
            while: { i < targetIndex } do: {
                newDeck := newDeck + [deck[i]]; i := i + 1;
                };

            newDeck := newDeck + [card];
            while: { i <= currentSize } do: {
                newDeck := newDeck + [deck[i]]; i := i + 1;
                };

            deck := newDeck;
        };

        def performShuffle(seeds) {
            def len := deck.length;
            if: ((len > 1).and: { seeds.length > 0 }) then: {
                def i := 1;
                while: { i < (seeds.length - 1) } do: {
                    def randA := seeds[i];
                    def randB := seeds[i+1];
                    def idxA := (randA * len).round() + 1;
                    def idxB := (randB * len).round() + 1;
                    if: (idxA > len) then: { idxA := len; }; if: (idxA < 1) then: { idxA := 1; };
                    if: (idxB > len) then: { idxB := len; }; if: (idxB < 1) then: { idxB := 1; };
                    def temp := deck[idxA]; deck[idxA] := deck[idxB]; deck[idxB] := temp;
                    i := i + 2;
                };
            };
        };

        def getTopCards(count) {
            def peekCards := [];
            def i := deck.length;
            def limit := 1;

            if: (deck.length < count) then: { count := deck.length; };
            if: (count > 0) then: { limit := deck.length - count + 1; };

            while: { i >= limit } do: {
                peekCards := peekCards + [deck[i]];
                i := i - 1;
            };
            peekCards;
        };

        // helpers for nope managament:
        def captureState() {
             def deckClone := [];
             deck.each: { |card| deckClone := deckClone + [card]; };
             isolate: {
                 def idx := currentPlayerIndex;
                 def turns := turnsToTake;
                 def next := nextTurnCount;
                 def savedDeck := deckClone;
             };
        };

        def cancelLastAction() {
            if: (lastState != nil) then: { // replace all like before.
                currentPlayerIndex := lastState.idx;
                turnsToTake := lastState.turns;
                nextTurnCount := lastState.next;
                deck := lastState.savedDeck;
            };
            if: (lastOp != nil) then: {
                restoreCardsToPlayer(lastOp);
            };
        };

        def redoLastAction() {
            if: (lastOp != nil) then: {
                consumeCardsForOp(lastOp);
            };
            executeOpLogic(lastOp);
        };

        def restoreCardsToPlayer(op) {
            def playerId := op.fromId;
            def count := 0;
            def opType := op.type;
            if: (opType == "PLAY_CARD") then: { count := 1; };
            if: (opType == "PLAY_PAIR") then: { count := 2; };
            if: (opType == "PLAY_TRIPLE") then: { count := 3; };
            if: (opType == "PLAY_SPECIAL_5") then: { count := 5; };

            def cardsToReturn := [];
            1.to: count do: { |k|
                def lastDiscardCard := discardPile[discardPile.length];
                if: (lastDiscardCard != nil) then: {
                    cardsToReturn := cardsToReturn + [lastDiscardCard];
                    def newDiscardPile := [];
                    1.to: (discardPile.length - 1) do: { |x| newDiscardPile := newDiscardPile + [discardPile[x]]; };
                    discardPile := newDiscardPile;
                };
            };
            hands.put(playerId, getHand(playerId) + cardsToReturn);
        };

        def passTurnNoDraw() {
            system.println("[PASS] Turn Pass (skip)");
            advanceTurn();
        };

        def advanceTurn() {
            currentPlayerIndex := (currentPlayerIndex + 1) % activePlayers.length; // "fair turn"
            turnsToTake := nextTurnCount;
            nextTurnCount := 1;
            system.println("[TURN] Player " + getCurrentPlayer() + " (actions: " + turnsToTake + ")");
        };

        def explosePlayer(playerId) {
            def idxToRemove := -1;
            def i := 0;
            activePlayers.each: { |player|

                if: (player == playerId) then: {
                    idxToRemove := i;
                    };

                i := i + 1;
                };

            if: (idxToRemove > -1) then: {
                def hand := hands.get(playerId);
                if: (hand != nil) then: {
                    discardPile := discardPile + hand;
                    hands.remove(playerId);
                };

                def newActive := [];
                activePlayers.each: { |player|
                    if: (player != playerId) then: {
                        newActive := newActive + [player];
                        };
                    };

                activePlayers := newActive;
                deadPlayers := deadPlayers + [playerId];

                if: (idxToRemove < currentPlayerIndex) then: { currentPlayerIndex := currentPlayerIndex - 1; };
                if: (currentPlayerIndex >= activePlayers.length) then: { currentPlayerIndex := 0; };

                turnsToTake := 1;
                nextTurnCount := 1;
                system.println("[EXPLOSION] Player " + playerId + " has EXPLODED ");
            };
        };
    };
  };
};